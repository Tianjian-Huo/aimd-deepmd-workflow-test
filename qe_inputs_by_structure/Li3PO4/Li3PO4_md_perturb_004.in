&CONTROL
   calculation      = 'md'
   nstep            = 50
   tstress          = .true.
   tprnfor          = .true.
   dt               = 20.0
   outdir           = './tmp/Li3PO4_md_perturb_004'
   prefix           = 'Li3PO4_md_perturb_004'
