&CONTROL
   calculation      = 'md'
   nstep            = 50
   tstress          = .true.
   tprnfor          = .true.
   dt               = 20.0
   outdir           = './tmp/Li2O_mp-13725_md_perturb_002'
   prefix           = 'Li2O_mp-13725_md_perturb_002'
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 50
   ecutrho          = 400
   nosym            = .true.
   noinv            = .true.
   occupations      = 'fixed'
   ntyp             = 2
   nat              = 12
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-06
/
&IONS
