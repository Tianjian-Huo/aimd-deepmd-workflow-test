&CONTROL
   calculation      = 'md'
   nstep            = 50
   tstress          = .true.
   tprnfor          = .true.
   dt               = 20.0
   outdir           = './tmp/Li2O_mp-1960_md_perturb_004'
   prefix           = 'Li2O_mp-1960_md_perturb_004'
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 50
   ecutrho          = 400
   nosym            = .true.
   noinv            = .true.
